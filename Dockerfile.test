FROM debian:12-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       bats jq coreutils findutils bash \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy the repository into the container for isolated testing
COPY . /app

# Ensure scripts are executable inside the image
RUN chmod +x *.sh adapters/*.sh lib/*.sh tests/*.bats tests/fixtures/fake_planner.sh

CMD ["bats", "tests"]
