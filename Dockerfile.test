FROM debian:12-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       bats jq coreutils findutils bash \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy the repository into the container for isolated testing
COPY . /app

CMD ["bats", "tests"]
